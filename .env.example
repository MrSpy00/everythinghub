# =============================================================================
# EverythingHub & HubSense — Environment Configuration Template (.env.example)
# =============================================================================
# 
# NOT: EverythingHub ve HubSense %100 API'siz, giri\u015fsiz ve sunucusuz (zero-auth)
# \u00e7al\u0131\u015facak \u015fekilde tasarlanm\u0131\u015ft\u0131r. Bu de\u011fi\u015fkenlerin H\u0130\u00c7B\u0130R\u0130 ZORUNLU DE\u011e\u0130LD\u0130R.
# Proje hi\u00e7bir de\u011fer girilmeden de t\u00fcm oyunlar\u0131, liderlik tablolar\u0131n\u0131 ve ara\u00e7lar\u0131
# eksiksiz, s\u0131f\u0131r gecikme ve tam g\u00fcvenlikle \u00e7al\u0131\u015ft\u0131r\u0131r.
#
# E\u011fer \u00f6zel 3. parti harici servisler veya bulut veritabanlar\u0131 ba\u011flamak isterseniz,
# bu dosyay\u0131 `.env.local` olarak kopyalay\u0131p de\u011ferleri doldurabilirsiniz.
# =============================================================================

# ─── 1. Site Genel Ayarlar\u0131 ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.everythinghub.com.tr
NEXT_PUBLIC_APP_NAME=EverythingHub
NODE_ENV=production

# ─── 2. HubSense Opsiyonel Harici Bulut Depolama (Opsiyonel) ──────────────────
# HubSense varsay\u0131lan olarak Next.js Serverless API ve istemci WebCrypto HMAC
# imzal\u0131 g\u00fcvenli bellek/yerel depolama ile sunucusuz \u00e7al\u0131\u015f\u0131r.
#
# E\u011fer kal\u0131c\u0131 harici Redis veya JSONbin ba\u011flamak isterseniz:
#
# Upstash Redis (Serverless Redis - \u00dccretsiz 10K istek/g\u00fcn):
# Link: https://console.upstash.com/
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
#
# JSONbin.io (\u00dccretsiz REST JSON Depolama - 10K istek/ay):
# Link: https://jsonbin.io/app/api-keys
# JSONBIN_API_KEY=
# JSONBIN_ACCESS_KEY=

# ─── 3. Opsiyonel Geli\u015fmi\u015f Ara\u00e7 API'leri (Opsiyonel) ────────────────────────
# Spotify Playlist & Profile Analyzer (Geli\u015fmi\u015f kota i\u00e7in opsiyonel):
# Link: https://developer.spotify.com/dashboard
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# YouTube Data API v3 (Y\u00fcksek hacimli kanal analizi i\u00e7in opsiyonel):
# Link: https://console.cloud.google.com/apis/credentials
# YOUTUBE_API_KEY=
