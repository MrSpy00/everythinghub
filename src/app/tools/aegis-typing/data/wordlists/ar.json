  "quotes": [
    {
      "text": "الخيل والليل والبيداء تعرفني والسيف والرمح والقلم والمكتب.",
      "author": "أبو الطيب المتنبي"
    },
    {
      "text": "على هذه الأرض ما يستحق الحياة.",
      "author": "محمود درويش"
    },
    {
      "text": "المعرفة قوة.",
      "author": "فرانسيس بيكون"
    },
    {
      "text": "الصبر مفتاح الفرج.",
      "author": "حكمة عربية"
    },
    {
      "text": "العلم في الصغر كالنقش على الحجر.",
      "author": "مثل عربي"
    },
    {
      "text": "لا تؤجل عمل اليوم إلى الغد.",
      "author": "مثل عربي"
    },
    {
      "text": "الوقت كالسيف إن لم تقطعه قطعك.",
      "author": "مثل عربي"
    },
    {
      "text": "خير جليس في الزمان كتاب.",
      "author": "أبو الطيب المتنبي"
    },
    {
      "text": "من طلب العلا سهر الليالي.",
      "author": "مثل عربي"
    },
    {
      "text": "جمال الروح هو الجمال الذي لا يفنى.",
      "author": "جبران خليل جبران"
    }
  ]
