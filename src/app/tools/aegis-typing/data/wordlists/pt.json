  "quotes": [
    {
      "text": "Tudo vale a pena se a alma não é pequena.",
      "author": "Fernando Pessoa"
    },
    {
      "text": "Navegar é preciso; viver não é preciso.",
      "author": "Fernando Pessoa"
    },
    {
      "text": "O valor das coisas não está no tempo que elas duram, mas na intensidade com que acontecem.",
      "author": "Fernando Pessoa"
    },
    {
      "text": "Renda-se, como eu me rendi. Chegue ao fim de você mesmo.",
      "author": "Clarice Lispector"
    },
    {
      "text": "A sabedoria começa na reflexão.",
      "author": "Sócrates"
    },
    {
      "text": "Não há lugar para a sabedoria onde não há paciência.",
      "author": "Santo Agostinho"
    },
    {
      "text": "Se podes olhar, vê. Se podes ver, repara.",
      "author": "José Saramago"
    },
    {
      "text": "A liberdade é a possibilidade de isolamento.",
      "author": "Fernando Pessoa"
    },
    {
      "text": "Sonhar grande e sonhar pequeno dá o mesmo trabalho.",
      "author": "Jorge Paulo Lemann"
    },
    {
      "text": "A verdadeira generosidade para com o futuro consiste em dar tudo ao presente.",
      "author": "Albert Camus"
    }
  ]
