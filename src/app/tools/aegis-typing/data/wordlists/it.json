    {
      "text": "Eppur si muove.",
      "author": "Galileo Galilei"
    },
    {
      "text": "Considerate la vostra semenza.",
      "author": "Dante Alighieri"
    },
    {
      "text": "L'unico modo per fare un ottimo lavoro è amare quello che fai.",
      "author": "Steve Jobs"
    },
    {
      "text": "Chi parla bene, pensa bene e sente bene.",
      "author": "Nanni Moretti"
    },
    {
      "text": "Nel mezzo del cammin di nostra vita mi ritrovai per una selva oscura.",
      "author": "Dante Alighieri"
    },
    {
      "text": "La bellezza salverà il mondo.",
      "author": "Fëdor Dostoevskij"
    },
    {
      "text": "Niente è impossibile per colui che ci proverà.",
      "author": "Alessandro Magno"
    },
    {
      "text": "Sii il cambiamento che vuoi vedere nel mondo.",
      "author": "Mahatma Gandhi"
    }
