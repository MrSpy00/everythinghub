  "quotes": [
    {
      "text": "Miej serce i patrzaj w serce.",
      "author": "Adam Mickiewicz"
    },
    {
      "text": "Nic nie zdarza sięprzypadkowo.",
      "author": "Wisława Szymborska"
    },
    {
      "text": "Czytanie książek to najpiękniejsza zabawa, jaką sobie ludzkość wymyśliła.",
      "author": "Wisława Szymborska"
    },
    {
      "text": "Świat jest pełen piękna, kiedy jest w nim miłość.",
      "author": "Henryk Sienkiewicz"
    },
    {
      "text": "Nie od razu Kraków zbudowano.",
      "author": "Przysłowie Polskie"
    },
    {
      "text": "Co cię nie zabije, to cię wzmocni.",
      "author": "Friedrich Nietzsche"
    },
    {
      "text": "Warto być uczciwym, choć nie zawsze się to opłaca.",
      "author": "Władysław Bartoszewski"
    },
    {
      "text": "Dobrze widzi się tylko sercem.",
      "author": "Antoine de Saint-Exupéry"
    },
    {
      "text": "Dopóki walczysz, jesteś zwycięzcą.",
      "author": "Św. Augustyn"
    },
    {
      "text": "Każdy jest kowalem własnego losu.",
      "author": "Przysłowie"
    }
  ]
