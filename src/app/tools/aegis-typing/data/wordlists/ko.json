  "quotes": [
    {
      "text": "시작이 반이다.",
      "author": "한국 속담"
    },
    {
      "text": "고생 끝에 낙이 온다.",
      "author": "한국 속담"
    },
    {
      "text": "뜻이 있는 곳에 길이 있다.",
      "author": "속담"
    },
    {
      "text": "실패는 성공의 어머니이다.",
      "author": "속담"
    },
    {
      "text": "가는 말이 고와야 오는 말이 곱다.",
      "author": "한국 속담"
    },
    {
      "text": "천 리 길도 한 걸음부터.",
      "author": "한국 속담"
    },
    {
      "text": "아는 것이 힘이다.",
      "author": "프랜시스 베이컨"
    },
    {
      "text": "시간은 금이다.",
      "author": "속담"
    },
    {
      "text": "오늘 할 일을 내일로 미루지 마라.",
      "author": "속담"
    },
    {
      "text": "진정한 성공은 행복을 느끼는 것이다.",
      "author": "명언"
    }
  ]
