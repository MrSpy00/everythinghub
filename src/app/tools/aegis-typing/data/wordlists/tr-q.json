  "quotes": [
    {
      "text": "Hayatta en hakiki mürşit ilimdir.",
      "author": "Mustafa Kemal Atatürk"
    },
    {
      "text": "Beni görmek demek mutlaka yüzümü görmek değildir. Benim fikirlerimi, benim duygularımı anlıyorsanız ve hissediyorsanız bu kafidir.",
      "author": "Mustafa Kemal Atatürk"
    },
    {
      "text": "Sevelim, sevilelim; bu dünya kimseye kalmaz.",
      "author": "Yunus Emre"
    },
    {
      "text": "Gel, ne olursan ol yine gel.",
      "author": "Mevlana Celaleddin-i Rumi"
    },
    {
      "text": "İnsan bir defa birine geç kalır ve bir daha hiç kimseye yetişemez.",
      "author": "Sabahattin Ali"
    },
    {
      "text": "Yaşamak bir ağaç gibi tek ve hür ve bir orman gibi kardeşçesine.",
      "author": "Nazım Hikmet"
    },
    {
      "text": "Bilgi sonu gelmez bir denizdir. Bilgin ise o denizde bir süngercidir.",
      "author": "Mevlana Celaleddin-i Rumi"
    },
    {
      "text": "Güzel günler göreceğiz çocuklar, güneşli günler göreceğiz.",
      "author": "Nazım Hikmet"
    },
    {
      "text": "Dünyayı güzellik kurtaracak, bir insanı sevmekle başlayacak her şey.",
      "author": "Sait Faik Abasıyanık"
    },
    {
      "text": "İlim ilim bilmektir, ilim kendin bilmektir.",
      "author": "Yunus Emre"
    },
    {
      "text": "Bütün ümidim gençliktedir.",
      "author": "Mustafa Kemal Atatürk"
    },
    {
      "text": "Ne mutlu Türk'üm diyene!",
      "author": "Mustafa Kemal Atatürk"
    },
    {
      "text": "İnsan ne kadar derin düşünürse, o kadar az konuşur.",
      "author": "Cemil Meriç"
    },
    {
      "text": "Kelamın en hayırlısı, az ve öz olanıdır.",
      "author": "Hz. Ali"
    },
    {
      "text": "Bir okur olarak doğdum, bir okur olarak öleceğim.",
      "author": "Jorge Luis Borges"
    },
    {
      "text": "Kendi ışığına güvenen, başkasının parlamasından rahatsızlık duymaz.",
      "author": "Victor Hugo"
    },
    {
      "text": "Özgürlük, adaletten başka bir şey değildir.",
      "author": "Voltaire"
    },
    {
      "text": "Başarı, küçük çabaların her gün tekrarlanmasıdır.",
      "author": "Robert Collier"
    }
  ]
}