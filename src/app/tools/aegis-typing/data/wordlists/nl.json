  "quotes": [
    {
      "text": "Al draagt een aap een gouden ring, het is en blijft een lelijk ding.",
      "author": "Nederlands Spreekwoord"
    },
    {
      "text": "Wie een kuil graaft voor een ander, valt er zelf in.",
      "author": "Spreekwoord"
    },
    {
      "text": "Zoals het klokje thuis tikt, tikt het nergens.",
      "author": "Spreekwoord"
    },
    {
      "text": "Oost west, thuis best.",
      "author": "Spreekwoord"
    },
    {
      "text": "Kennis is macht.",
      "author": "Francis Bacon"
    },
    {
      "text": "Ik denk, dus ik ben.",
      "author": "René Descartes"
    },
    {
      "text": "Wie goed doet, goed ontmoet.",
      "author": "Spreekwoord"
    },
    {
      "text": "Beter laat dan nooit.",
      "author": "Spreekwoord"
    },
    {
      "text": "De aanhouder winst.",
      "author": "Spreekwoord"
    },
    {
      "text": "Een goed begin is het halve werk.",
      "author": "Spreekwoord"
