  "quotes": [
    {
      "text": "Le coeur a ses raisons que la raison ne connaît point.",
      "author": "Blaise Pascal"
    },
    {
      "text": "Je pense, donc je suis.",
      "author": "René Descartes"
    },
    {
      "text": "On ne voit bien qu'avec le coeur. L'essentiel est invisible pour les yeux.",
      "author": "Antoine de Saint-Exupéry"
    },
    {
      "text": "La liberté consiste à pouvoir faire tout ce qui ne nuit pas à autrui.",
      "author": "Voltaire"
    },
    {
      "text": "Le savoir est la seule matière qui s'accroît quand on la partage.",
      "author": "Socrates"
    },
    {
      "text": "L'enfer, c'est les autres.",
      "author": "Jean-Paul Sartre"
    },
    {
      "text": "Vouloir, c'est pouvoir.",
      "author": "Proverbe Français"
    },
    {
      "text": "La vie est un mystère qu'il faut vivre, non un problème à résoudre.",
      "author": "Gabriel Marcel"
    },
    {
      "text": "Rien ne sert de courir; il faut partir à point.",
      "author": "Jean de La Fontaine"
    },
    {
      "text": "Il n'y a qu'un bonheur dans cette vie, c'est d'aimer et d'être aimé.",
      "author": "George Sand"
    }
  ]
