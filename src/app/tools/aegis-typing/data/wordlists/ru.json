  "quotes": [
    {
      "text": "Красота спасет мир.",
      "author": "Фёдор Достоевский"
    },
    {
      "text": "Умом Россию не понять, аршином общим не измерить.",
      "author": "Фёдор Тютчев"
    },
    {
      "text": "Все счастливые семьи похожи друг на друга, каждая несчастливая семья несчастлива по-своему.",
      "author": "Лев Толстой"
    },
    {
      "text": "В human человеке должно быть всё прекрасно: и лицо, и одежда, и душа, и мысли.",
      "author": "Антон Чехов"
    },
    {
      "text": "Рукописи не горят.",
      "author": "Михаил Булгаков"
    },
    {
      "text": "Ученье — свет, а неученье — тьма.",
      "author": "Александр Суворов"
    },
    {
      "text": "Любви все возрасты покорны.",
      "author": "Александр Пушкин"
    },
    {
      "text": "Я мыслию, следовательно, я существую.",
      "author": "Рене Декарт"
    },
    {
      "text": "Жизнь прожита не зря, если ты сделал счастливым хотя бы одного человека.",
      "author": "Народная мудрость"
    },
    {
      "text": "Век живи — век учись.",
      "author": "Русская пословица"
    }
  ]
}