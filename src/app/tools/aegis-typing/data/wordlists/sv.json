  "quotes": [
    {
      "text": "Ge barnen kärlek, mera kärlek och ännu mera kärlek, så kommer folkvettet av sig själv.",
      "author": "Astrid Lindgren"
    },
    {
      "text": "Att våga är att förlora fotfästet en stund. Att inte våga är att förlora sig själv.",
      "author": "Søren Kierkegaard"
    },
    {
      "text": "Ingen kan göra allt, men alla kan göra något.",
      "author": "Svenskt ordspråk"
    },
    {
      "text": "Borta bra men hemma bäst.",
      "author": "Ordspråk"
    },
    {
      "text": "Det finns inget dåligt väder, bara dåliga kläder.",
      "author": "Svenskt ordspråk"
    },
    {
      "text": "Finns det hjärterum så finns det stjärterum.",
      "author": "Ordspråk"
    },
    {
      "text": "Kunskap är makt.",
      "author": "Francis Bacon"
    },
    {
      "text": "Tala är silver, tiga är guld.",
      "author": "Ordspråk"
    },
    {
      "text": "Ärlig varaktighet varar längst.",
      "author": "Ordspråk"
    },
    {
      "text": "Morgonstund har guld i mund.",
      "author": "Ordspråk"
    }
  ]
