  "quotes": [
    {
      "text": "学而时习之，不亦说乎？",
      "author": "孔子 (Confucius)"
    },
    {
      "text": "千里之行，始于足下。",
      "author": "老子 (Laozi)"
    },
    {
      "text": "知己知彼，百战不殆。",
      "author": "孙子 (Sun Tzu)"
    },
    {
      "text": "温故而知新，可以为师矣。",
      "author": "孔子 (Confucius)"
    },
    {
      "text": "三人行，必有我师焉。",
      "author": "孔子 (Confucius)"
    },
    {
      "text": "海内存知己，天涯若比邻。",
      "author": "王勃"
    },
    {
      "text": "己所不欲，勿施于人。",
      "author": "孔子 (Confucius)"
    },
    {
      "text": "天行健，君子以自强不息。",
      "author": "《周易》"
    },
    {
      "text": "读万卷书，行万里路。",
      "author": "董其昌"
    },
    {
      "text": "少壮不努力，老大徒伤悲。",
      "author": "《长歌行》"
    }
  ]
